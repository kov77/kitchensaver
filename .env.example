NODE_ENV=development
# Railway injects PORT in deployed services
PORT=3000
# Local: public URL of the Railway DEVELOPMENT database. Deployed: private URL via reference variable.
DATABASE_URL=
# Database tests only: public URL of the dedicated TEST database (never the development or production one).
TEST_DATABASE_URL=

# Rate limits and AI spending controls (values decided in Phase 2/7)
AI_PROVIDER_API_KEY=
AI_MONTHLY_BUDGET_USD=
AI_ACCOUNT_MONTHLY_BUDGET_USD=

# Auth (Supabase Auth, ADR D027); public values, no secrets.
# JWKS URL: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Issuer: https://<project-ref>.supabase.co/auth/v1 ; audience: authenticated
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# --- Mobile (PUBLIC: embedded in the app bundle, never put secrets here) ---
EXPO_PUBLIC_API_URL=

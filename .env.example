NODE_ENV=development
# Railway injects PORT in deployed services
PORT=3000
# Local: public URL of the Railway DEVELOPMENT database. Deployed: private URL via reference variable.
DATABASE_URL=
# Database tests only: a dedicated local TEST database, e.g. postgresql://<your-mac-user>@localhost:5432/kitchensaver_test
# (PostgreSQL 18, same major version as Railway and CI). The name must be `test` or end in `_test`: every test run empties all its tables.
# Never the development or production database.
TEST_DATABASE_URL=

# Rate limits and AI spending controls (values decided in Phase 2/7)
AI_PROVIDER_API_KEY=
AI_MONTHLY_BUDGET_USD=
AI_ACCOUNT_MONTHLY_BUDGET_USD=

# Auth (Supabase Auth, ADR D027); public values, no secrets.
# JWKS URL: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Issuer: https://<project-ref>.supabase.co/auth/v1 ; audience: authenticated
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

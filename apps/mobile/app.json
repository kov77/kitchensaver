{
  "expo": {
    "name": "KitchenSaver",
    "slug": "kitchensaver",
    "scheme": "kitchensaver",
    "version": "1.0.0",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "com.kitchensaver.dev"
    },
    "android": {
      "package": "com.kitchensaver.dev"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

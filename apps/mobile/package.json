{
  "name": "@kitchensaver/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "api:types": "openapi-typescript ../api/openapi.json -o src/api/generated/schema.d.ts",
    "postinstall": "pnpm api:types",
    "prestart": "pnpm api:types",
    "pretypecheck": "pnpm api:types",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm api:types",
    "test": "jest"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.2",
    "expo": "58.0.26",
    "expo-constants": "58.0.16",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.32",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-hook-form": "7.92.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "openapi-typescript": "7.13.0"
  }
}
